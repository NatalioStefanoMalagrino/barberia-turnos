# Copiá este archivo como .env y completá los valores.
# Nunca subas el .env a GitHub: tiene la contraseña de la base.

# Cadena de conexión a PostgreSQL (local, Supabase o Neon)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/barberia

# Clave para firmar la cookie de sesión del panel. Generá una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar-esto

# URL pública del sitio (se usa para armar el link de cancelación)
BASE_URL=http://localhost:8000
